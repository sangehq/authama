# secrets / runtime state: NEVER commit. The real per-user homes are
# ~/.config/authama and ~/.local/state/authama (outside the repo); src/config/
# here is only the example manifest + schemas.
# These patterns contain a slash, so they anchor to this file's directory - they
# had to move with the config directory rather than keep matching at the root.
.env
src/config/.env
# a sandbox home used while developing (CONTRIBUTING.md)
/.devhome/
**/age-identity.txt
**/*-identity.txt
*.age
*.age.sha256
*.age.contents
src/config/log/
src/config/snapshots/
src/config/.state/
# runtime state that older builds wrote into ./src/config (now in the state home)
src/config/.lock
src/config/.expiry-cache.json
src/config/.notify-cache.json
src/config/audit.log

# generated ~/.ssh is NOT in this repo; if you also version it via chezmoi,
# allowlist only *.pub and config there, never private keys.

# os / editor / tooling
.DS_Store
*.swp
.idea/
.vscode/
.claude/

# Shipping checklist is a personal release-prep aid, never tracked
docs/shipping-checklist.md

# Per-machine ssh reconciliation worklist, never tracked
docs/ssh-worklist.md

# ai-cleanup tool artifacts (never tracked)
reports/
cleaned/
*.bak

# Go (sshmgr: the name before authama, which an old local build may leave behind)
/authama
/authama.exe
/sshmgr
/sshmgr.exe
*.test
/vendor/

# Everything build-related lives under build/, per the note at the top of
# src/.goreleaser.yaml. build/ stays at the repo root while the Go module is
# src/: output belongs to the repository, so there is one build/ and not one
# per module. Only targets.txt is tracked; the rest is generated:
#   build/targets.txt   the release matrix (TRACKED)
#   build/{os}/         binaries: `make build` (the host's), `make cross`
#   build/checksums.txt SHA-256 over every binary, as {os}/{file}
#   build/archives/     `make dist`: tar.gz/zip, Authama.app zip, man pages
/build/*
!/build/targets.txt

# GoReleaser's working output (release.yml, `make release-snapshot`).
/.goreleaser-dist/

# Belt and braces: the rules above are anchored to the repo root, so a build/
# that appears anywhere else - src/build/, say, from a tool invoked with the
# wrong working directory - would not be caught by them. These are. build/dist/
# is the layout before the per-OS folders, kept ignored for old checkouts.
build/dist/
**/build/dist/

# The dev container home (compose.yaml): token files the container writes.
.authama-home/
